#include <cio.h>
#include <ios.pph>
#include <def.h>
#include <alloc.h>
#include <parr.h>
#include <dstr.h>
#include <files.pph>
#include <uefi_sys.h>

#define KERNEL_PATH "vmlinuz"
#define CMDLINE "console=tty0 console=ttyS0,115200n8 initrd=\\initrd.img"

// build command:
// make -f Makefile.uefi APP=uefi-linux LINUX_SIZE_MB=64 QEMU_FLAGS="-m 2048 -nic user,model=virtio-net-pci,dns=$(ip route | grep default | awk '{print $3}') -display none" linux
// to boot, use these args at startup (w/o newlines, e.g. arg1 arg2 arg3 ...) and hit enter:
// loglevel=6 ip=10.0.2.15::10.0.2.2:255.255.255.0:alpine:eth0:none:1.1.1.1
// alpine_repo=http://dl-cdn.alpinelinux.org/alpine/v3.20/main/
// modloop=http://dl-cdn.alpinelinux.org/alpine/v3.20/releases/x86_64/netboot/modloop-virt

static CHAR16 g_cmdline[1024];

static bool read_all(const char *path, u8 **out, size_t *size)
{
    Stream *f = fopen(path, "r");
    if (!f) return false;

    CALL2(f, seek, 0, FS_SEEK_END);
    i64 n = CALL0(f, tell);
    CALL2(f, seek, 0, FS_SEEK_SET);
    if (n <= 0) { REMOVE(f); return false; }

    u8 *buf = malloc((size_t)n);
    size_t got = 0;
    while (buf && got < (size_t)n)
    {
        i64 r = CALL2(f, read, buf + got, (size_t)n - got);
        if (r <= 0) break;
        got += (size_t)r;
    }
    REMOVE(f);

    if (!buf || got != (size_t)n) { free(buf); return false; }
    *out  = buf;
    *size = got;
    return true;
}

int program(parr_t csArgs)
{
    (void)csArgs;
    EFI_BOOT_SERVICES *bs = __uefi_st->BootServices;

    u8 *kernel = NULL;
    size_t ksize = 0;
    if (!read_all(KERNEL_PATH, &kernel, &ksize))
    {
        printf("error: cannot read \\%s from the boot volume\n", KERNEL_PATH);
        return 1;
    }
    printf("read %d bytes from \\%s\n", (int)ksize, KERNEL_PATH);

    dstr_t userArgs;
    printf("type any additional args to append, then hit enter:\n%s ", CMDLINE);
    freadline(cin(), &userArgs);

    dstr_t finalCmd = dstr_new(CMDLINE);
    if (userArgs.len > 0)
    {
        dstr_append_char(&finalCmd, ' ');
        dstr_append(&finalCmd, userArgs.data);
    }

    size_t n = 0;
    while (finalCmd.data[n] && n < (sizeof(g_cmdline)/sizeof(CHAR16)) - 1) 
    { 
        g_cmdline[n] = (CHAR16)(unsigned char)finalCmd.data[n]; 
        n++; 
    }
    g_cmdline[n] = 0;

    dstr_free(&finalCmd);
    dstr_free(&userArgs);

    EFI_HANDLE child = NULL;
    EFI_STATUS st = bs->LoadImage(0, __uefi_image, NULL, kernel, ksize, &child);
    if (EFI_ERROR(st))
    {
        printf("LoadImage failed: 0x%llx (is this not an EFI-stub kernel? Is Secure Boot on?)\n", (long long)st);
        free(kernel);
        return 1;
    }

    EFI_GUID lig = EFI_LOADED_IMAGE_GUID;
    EFI_LOADED_IMAGE_PROTOCOL *self_li = NULL, *kern_li = NULL;
    bs->HandleProtocol(__uefi_image, &lig, (void **)&self_li);
    bs->HandleProtocol(child,        &lig, (void **)&kern_li);
    if (!self_li || !kern_li)
    {
        puts("error: no LoadedImage protocol", SIOOUT);
        return 1;
    }

    kern_li->DeviceHandle    = self_li->DeviceHandle;
    kern_li->LoadOptions     = g_cmdline;
    kern_li->LoadOptionsSize = (UINT32)((n + 1) * sizeof(CHAR16));

    puts("starting kernel:", SIOOUT);

    st = bs->StartImage(child, NULL, NULL);

    printf("kernel returned: 0x%llx\n", (long long)st);
    return 1;
}
