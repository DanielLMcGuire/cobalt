#include <class.pph>
#include <cio.h>
#include <def.h>
#include "uefi/display.pph"
#include "uefi/bmp.h"

static const u8 g_logo_bmp[] = {
#embed "uefi-bmp.bmp"
};

int program(parr_t csArgs)
{
    (void)csArgs;

    EFI_SIMPLE_TEXT_OUTPUT *con = __uefi_st->ConOut;
    con->ClearScreen(con);

    SCOPED_NEW(Display, disp);
    if (!display_init(disp))
    {
        print("Failed to initialize GOP framebuffer\n", SIOERR);
        return 1;
    }

    CALL5(disp, fill_rect, 0, 0, (i32)disp->width, (i32)disp->height, CALL3(disp, color, 20, 25, 35));

    const bmp_info_header_t *info = (const bmp_info_header_t *)(g_logo_bmp + sizeof(bmp_file_header_t));
    i32 bmp_w = info->biWidth;
    i32 bmp_h = info->biHeight > 0 ? info->biHeight : -info->biHeight;

    i32 center_x = ((i32)disp->width - bmp_w) / 2;
    i32 center_y = ((i32)disp->height - bmp_h) / 2;

    if (!draw_bitmap(disp, g_logo_bmp, sizeof(g_logo_bmp), center_x, center_y))
        printf("Failed to draw bitmap\n");

    return 0;
}
