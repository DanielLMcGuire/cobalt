#include <cio.h>
#include <str.h>
#include <mem.h>
#include <sig.h>
#include <atexit.h>
#include <atomic.h>

#include <class.pph>
#include <app.pph>
#include <socket.pph>

CLASS(SocketDemo, Application)
{
    BASE(Application)
    
    METHOD(void, run_server, (void *self))
    METHOD(void, run_client, (void *self))
};

CLASS_EXPORT(SocketDemo);

static volatile atomic_bool_t g_interrupted;
static volatile atomic_u8_t g_interrupt_count;

static void handle_sigint(int sig)
{
    (void)sig;
    u8 iInterrupt = atomic_u8_fetch_add(&g_interrupt_count, 1) + 1;
    bool bInterrupt = atomic_bool_load(&g_interrupted);
    if (iInterrupt == 1)
            while (!atomic_bool_cas(&g_interrupted, &bInterrupt, !bInterrupt)) {}
    else if (iInterrupt >= 2)
        _exit(130);
}

int program(parr_t csArgs)
{
    (void)csArgs;
    atomic_u8_init(&g_interrupt_count, 0);
    atomic_bool_init(&g_interrupted, false);
    if (signal(SIGINT, handle_sigint) == SIG_ERR)
        return 1;

#if defined(__GNUC__) || defined(__clang__)
    SCOPED_NEW(SocketDemo, demo);
#else
    SocketDemo *demo = NEW(SocketDemo);
#endif
    if (!demo)
        return 1;

    Application *app = AS(Application, demo);

    CALL1(app, parse_args, &csArgs);

    int exit_code = 0;

    bool bInterrupt = atomic_bool_load(&g_interrupted);
    if (bInterrupt)
        exit_code = 130;
    else
        exit_code = CALL0(app, main);

#if !defined(__GNUC__) && !defined(__clang__)
    REMOVE(demo);
#endif

    bInterrupt = atomic_bool_load(&g_interrupted);
    
    if (bInterrupt && exit_code == 0)
        exit_code = 130;

    return exit_code;
}

METHOD_PROTO(SocketDemo, void, configure_args, (void *self));
METHOD_PROTO(SocketDemo, int, run, (void *self));
METHOD_PROTO(SocketDemo, void, run_server, (void *self));
METHOD_PROTO(SocketDemo, void, run_client, (void *self));

CLASS_INFO(SocketDemo, Application);

CONSTRUCTOR(SocketDemo)
{
    SUPER_CTOR(self, Application);

    METHOD_LINK(base, SocketDemo, configure_args);
    METHOD_LINK(base, SocketDemo, run);
    
    METHOD_LINK(SocketDemo, run_server);
    METHOD_LINK(SocketDemo, run_client);
}

DECONSTRUCTOR(SocketDemo)
{
    SUPER_DTOR(self, Application);
}

IMPLEMENT(SocketDemo, void, configure_args, (void *self))
{
    SocketDemo *this = (SocketDemo *)self;
    
    CALL2(this->base.args, add_flag, "server", "Run as a TCP Server");
    CALL2(this->base.args, add_flag, "client", "Run as a TCP Client");
}

IMPLEMENT(SocketDemo, int, run, (void *self))
{
    SocketDemo *this = (SocketDemo *)self;

    bool is_server = CALL1(this->base.args, get_bool, "server");
    bool is_client = CALL1(this->base.args, get_bool, "client");

    if (is_server) {
        this->run_server(self);
        return 0;
    } else if (is_client) {
        this->run_client(self);
        return 0;
    }

    puts("Please specify either --server or --client", SIOOUT);
    return 1;
}

IMPLEMENT(SocketDemo, void, run_server, (void *self))
{
    (void)self;
    u16 port = 8080;
    printf("Starting server on port %d...\n", port);

    SocketStream *listener = tcp_listen(SOCK_INADDR_ANY, port, 5);
    
    if (!listener) {
        printf("Failed to bind/listen on port %d.\n", port);
        return;
    }

    puts("Waiting for a connection...", SIOOUT);

    sock_addr_in_t peer_addr;
    Stream *client = tcp_accept(listener, &peer_addr);

    if (client) {
        puts("Client connected!", SIOOUT);

        CALL1(client, fprintln, "Welcome to the ++C Server!");

        char buf[256] = {0};
        i64 bytes = CALL2(client, read, buf, sizeof(buf) - 1);
        
        if (bytes > 0) {
            printf("Received from client: %s\n", buf);
        }

        REMOVE(client);
    }

    REMOVE(listener);
}

IMPLEMENT(SocketDemo, void, run_client, (void *self))
{
    (void)self;
    u16 port = 8080;
    const char* host = "127.0.0.1";
    
    printf("Connecting to %s:%d...\n", host, port);

    Stream *conn = tcp_connect(host, port);
    
    if (!conn) {
        puts("Connection failed.", SIOOUT);
        return;
    }

    puts("Connected!", SIOOUT);

    char buf[256] = {0};
    CALL2(conn, read, buf, sizeof(buf) - 1);
    printf("Server says: %s", buf);

    CALL1(conn, fprintln, "Hello from ++C Client!\n");

    REMOVE(conn);
}