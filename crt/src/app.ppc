#include <app.pph>
#include <sio.h>

CLASS_INFO_ROOT(App);

CONSTRUCTOR(App)
{
    self->show_help = false;
    self->program = (dstr_t){0};
    self->args = NEW(ArgParser);

    METHOD_LINK(App, configure_args);
    METHOD_LINK(App, run);
    METHOD_LINK(App, parse_args);
    METHOD_LINK(App, print_help);
    METHOD_LINK(App, main);
}

DECONSTRUCTOR(App)
{
    REMOVE(self->args);
    dstr_free(&self->program);
}

IMPLEMENT(App, void, configure_args, (void *self))
{
    (void)self;
}

IMPLEMENT(App, int, run, (void *self))
{
    (void)self;
    return 0;
}

IMPLEMENT(App, void, parse_args, (void *self, const parr_t *argv))
{
    App *this = (App *)self;

    this->program = dstr_new((argv && argv->len > 0) ? (const char *)argv->data[0] : "");

    CALL2(this->args, add_flag, "help", "Show this help message and exit");

    this->configure_args(self);

    CALL1(this->args, parse, argv);

    this->show_help = CALL1(this->args, get_bool, "help");
}

IMPLEMENT(App, void, print_help, (void *self))
{
    App *this = (App *)self;

    printf("Usage: %s [OPTIONS...]\n", this->program.data ? this->program.data : "app");
    puts("OPTIONS:", SIOOUT);
    CALL0(this->args, print_flags);
}

IMPLEMENT(App, int, main, (void *self))
{
    App *this = (App *)self;

    if (this->show_help)
    {
        this->print_help(self);
        return 0;
    }

    return this->run(self);
}
