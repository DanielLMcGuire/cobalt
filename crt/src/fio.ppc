#include <fio.pph>
#include <alloc.h>
#include <str.h>
#include <sio.h>

#if defined(_WIN32)
#include <windows.h>
#endif

#if defined(__linux__)
#include "sys_linux.h"
#endif

IMPLEMENT(FileStream, i64, read, (void *self, void *buf, size_t n))
{
    FileStream *this = (FileStream *)self;

#if defined(_WIN32)

    if (!this->fd || this->fd == INVALID_HANDLE_VALUE)
        return -1;

    if (!buf || n == 0)
        return 0;

    DWORD request = n > (size_t)MAXDWORD
        ? MAXDWORD
        : (DWORD)n;

    DWORD bytes_read = 0;

    if (!ReadFile(this->fd, buf, request, &bytes_read, NULL))
    {
        DWORD error = GetLastError();

        if (error == ERROR_BROKEN_PIPE || error == ERROR_HANDLE_EOF)
        {
            this->eof_flag = true;
            return 0;
        }

        return -1;
    }

    if (bytes_read == 0)
        this->eof_flag = true;

    return (i64)bytes_read;

#elif defined(__linux__)

    long r = sys_read(this->fd, buf, n);

    if (r == 0)
        this->eof_flag = true;

    return r;

#else

    (void)this;
    (void)buf;
    (void)n;

    return -1;

#endif
}


IMPLEMENT(FileStream, i64, write, (void *self, const void *buf, size_t n))
{
    FileStream *this = (FileStream *)self;

#if defined(_WIN32)

    if (!this->fd || this->fd == INVALID_HANDLE_VALUE)
        return -1;

    if (!buf || n == 0)
        return 0;

    DWORD request = n > (size_t)MAXDWORD
        ? MAXDWORD
        : (DWORD)n;

    DWORD bytes_written = 0;

    if (!WriteFile(this->fd, buf, request, &bytes_written, NULL))
        return -1;

    return (i64)bytes_written;

#elif defined(__linux__)

    return sys_write(this->fd, buf, n);

#else

    (void)this;
    (void)buf;
    (void)n;

    return -1;

#endif
}


IMPLEMENT(FileStream, i64, seek, (void *self, i64 offset, int whence))
{
    FileStream *this = (FileStream *)self;

#if defined(_WIN32)

    if (!this->fd || this->fd == INVALID_HANDLE_VALUE)
        return -1;

    DWORD method;

    switch (whence)
    {
        case FS_SEEK_SET:
            method = FILE_BEGIN;
            break;

        case FS_SEEK_CUR:
            method = FILE_CURRENT;
            break;

        case FS_SEEK_END:
            method = FILE_END;
            break;

        default:
            return -1;
    }

    LARGE_INTEGER distance;
    LARGE_INTEGER position;

    distance.QuadPart = offset;

    if (!SetFilePointerEx(this->fd, distance, &position, method))
        return -1;

    this->eof_flag = false;

    return (i64)position.QuadPart;

#elif defined(__linux__)

    long r = sys_lseek(this->fd, offset, whence);

    if (r >= 0)
        this->eof_flag = false;

    return r;

#else

    (void)this;
    (void)offset;
    (void)whence;

    return -1;

#endif
}


IMPLEMENT(FileStream, i64, tell, (void *self))
{
    FileStream *this = (FileStream *)self;

#if defined(_WIN32)

    if (!this->fd || this->fd == INVALID_HANDLE_VALUE)
        return -1;

    LARGE_INTEGER zero;
    LARGE_INTEGER position;

    zero.QuadPart = 0;

    if (!SetFilePointerEx(this->fd, zero, &position, FILE_CURRENT))
        return -1;

    return (i64)position.QuadPart;

#elif defined(__linux__)

    return sys_lseek(this->fd, 0, FS_SEEK_CUR);

#else

    (void)this;

    return -1;

#endif
}


IMPLEMENT(FileStream, int, eof, (void *self))
{
    FileStream *this = (FileStream *)self;

    return this->eof_flag ? 1 : 0;
}


IMPLEMENT(FileStream, void, close, (void *self))
{
    FileStream *this = (FileStream *)self;

#if defined(_WIN32)

    if (this->owns_fd && this->fd && this->fd != INVALID_HANDLE_VALUE)
    {
        CloseHandle(this->fd);
        this->fd = INVALID_HANDLE_VALUE;
    }

#elif defined(__linux__)

    if (this->owns_fd && this->fd >= 0)
    {
        sys_close(this->fd);
        this->fd = -1;
    }

#else

    (void)this;

#endif
}


CONSTRUCTOR(FileStream)
{
    SUPER_CTOR(self, Stream);

#if defined(_WIN32)
    self->fd = INVALID_HANDLE_VALUE;
#else
    self->fd = -1;
#endif

    self->owns_fd  = false;
    self->eof_flag  = false;

    METHOD_LINK(base, FileStream, read);
    METHOD_LINK(base, FileStream, write);
    METHOD_LINK(base, FileStream, seek);
    METHOD_LINK(base, FileStream, tell);
    METHOD_LINK(base, FileStream, eof);
    METHOD_LINK(base, FileStream, close);
}


DECONSTRUCTOR(FileStream)
{
#if defined(_WIN32)

    if (self->owns_fd && self->fd && self->fd != INVALID_HANDLE_VALUE)
        CloseHandle(self->fd);

    self->fd = INVALID_HANDLE_VALUE;

#elif defined(__linux__)

    if (self->owns_fd && self->fd >= 0)
        sys_close(self->fd);

    self->fd = -1;

#endif

    SUPER_DTOR(self, Stream);
}


CLASS_INFO(FileStream, Stream);


Stream *fopen(const char *path, const char *mode)
{
    if (!path || !mode || !mode[0])
        return NULL;

#if defined(_WIN32)

    DWORD access;
    DWORD creation;

    switch (mode[0])
    {
        case 'r':
            access = mode[1] == '+'
                ? GENERIC_READ | GENERIC_WRITE
                : GENERIC_READ;

            creation = OPEN_EXISTING;
            break;

        case 'w':
            access = mode[1] == '+'
                ? GENERIC_READ | GENERIC_WRITE
                : GENERIC_WRITE;

            creation = CREATE_ALWAYS;
            break;

        case 'a':
            access = mode[1] == '+'
                ? GENERIC_READ | FILE_APPEND_DATA
                : FILE_APPEND_DATA;

            creation = OPEN_ALWAYS;
            break;

        default:
            return NULL;
    }

    HANDLE handle = CreateFileA(
        path,
        access,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
        NULL,
        creation,
        FILE_ATTRIBUTE_NORMAL,
        NULL
    );

    if (handle == INVALID_HANDLE_VALUE)
        return NULL;

    FileStream *fs = NEW(FileStream);

    if (!fs)
    {
        CloseHandle(handle);
        return NULL;
    }

    fs->fd       = handle;
    fs->owns_fd  = true;
    fs->eof_flag = false;

    return (Stream *)fs;

#elif defined(__linux__)

    int flags;

    switch (mode[0])
    {
        case 'r':
            flags = mode[1] == '+'
                ? O_RDWR
                : O_RDONLY;
            break;

        case 'w':
            flags = (mode[1] == '+'
                ? O_RDWR
                : O_WRONLY) | O_CREAT | O_TRUNC;
            break;

        case 'a':
            flags = (mode[1] == '+'
                ? O_RDWR
                : O_WRONLY) | O_CREAT | O_APPEND;
            break;

        default:
            return NULL;
    }

    long fd = sys_openat(
        AT_FDCWD,
        path,
        flags,
        0666
    );

    if (fd < 0)
        return NULL;

    FileStream *fs = NEW(FileStream);

    if (!fs)
    {
        sys_close((int)fd);
        return NULL;
    }

    fs->fd       = (int)fd;
    fs->owns_fd  = true;
    fs->eof_flag = false;

    return (Stream *)fs;

#else

    (void)path;
    (void)mode;

    return NULL;

#endif
}


static FileStream *g_stdin_stream;
static FileStream *g_stdout_stream;
static FileStream *g_stderr_stream;

void fs_init(FileStream *stdin, FileStream *stdout, FileStream *stderr)
{
    g_stdin_stream = stdin;
    g_stdout_stream = stdout;
    g_stderr_stream = stderr;
}

Stream *stdin(void)
{
    return (Stream *)g_stdin_stream;
}

Stream *stdout(void)
{
    return (Stream *)g_stdout_stream;
}


Stream *stderr(void)
{
    return (Stream *)g_stderr_stream;
}

i64 fwrite(Stream *s, const char *str)
{
    if (!s || !str)
        return -1;

    return CALL2(s, write, str, strlen(str));
}


i64 freadline(Stream *s, dstr_t *out)
{
    if (!s || !out)
        return -1;

    *out = dstr_new("");

    i64 total = 0;
    char c;

    for (;;)
    {

        i64 r = CALL2(s, read, &c, 1);

        if (r <= 0)
            break;

        total++;

        if (c == '\n')
            break;

        dstr_append_char(out, c);
    }

    return total;
}


int fprintf(Stream *s, const char *fmt, ...)
{
    char stack_buf[1024];

    va_list args;

    va_start(args, fmt);

    int len = vsnprintf(
        stack_buf,
        sizeof(stack_buf),
        fmt,
        args
    );

    va_end(args);

    if (len < 0)
        return len;

    if (len < (int)sizeof(stack_buf)) 
    {
        fwrite(s, stack_buf);
        return len;
    }

    char *buf = (char *)malloc((size_t)len + 1);

    if (!buf)
    {
        fwrite(s, stack_buf);
        return len;
    }

    va_start(args, fmt);

    vsnprintf(
        buf,
        (size_t)len + 1,
        fmt,
        args
    );

    va_end(args);

    fwrite(s, buf);

    free(buf);

    return len;
}