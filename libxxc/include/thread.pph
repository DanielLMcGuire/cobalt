#ifndef XXC_THREAD_H
#define XXC_THREAD_H

#include <class.pph>
#include <thread.h>
#include <runnable.pph>

CLASS(Thread)
{
    FIELD(thread_t, handle)
    FIELD(Runnable *, target)
    FIELD(bool, owns_target)
    FIELD(bool, started)
    FIELD(bool, joined)

    METHOD(bool,   start,          (void *self))
    METHOD(bool,   start_detached, (void *self))
    METHOD(void *, join,           (void *self))
    METHOD(bool,   detach,         (void *self))
    METHOD(bool,   is_joinable,    (void *self))
    METHOD(u32,    get_id,         (void *self))
};

CLASS_EXPORT(Thread);

METHOD_PROTO(Thread, bool,   start,          (void *self));
METHOD_PROTO(Thread, bool,   start_detached, (void *self));
METHOD_PROTO(Thread, void *, join,           (void *self));
METHOD_PROTO(Thread, bool,   detach,         (void *self));
METHOD_PROTO(Thread, bool,   is_joinable,    (void *self));
METHOD_PROTO(Thread, u32,    get_id,         (void *self));

Thread *thread_new(Runnable *target);

Thread *thread_new_fn(thread_fn_t fn, void *arg);

#endif /* XXC_THREAD_H */
