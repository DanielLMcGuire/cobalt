#ifndef APP_H
#define APP_H

#include <class.pph>
#include <argparse.pph>
#include <dstr.h>
#include <parr.h>

CLASS(Application)
{
    FIELD(ArgParser *, args)
    FIELD(bool, show_help)
    FIELD(dstr_t, program)

    METHOD(void, configure_args, (void *self))
    METHOD(int, run, (void *self))

    METHOD(void, parse_args, (void *self, const parr_t *argv))
    METHOD(void, print_help, (void *self))
    METHOD(int, main, (void *self))
};

CLASS_EXPORT(Application);

METHOD_PROTO(Application, void, configure_args, (void *self));
METHOD_PROTO(Application, void, configure_args, (void *self));
METHOD_PROTO(Application, int, run, (void *self));
METHOD_PROTO(Application, void, parse_args, (void *self, const parr_t *argv));
METHOD_PROTO(Application, void, print_help, (void *self));
METHOD_PROTO(Application, int, main, (void *self));

#endif /* Application_H */
