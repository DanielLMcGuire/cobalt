#ifndef IAPP_H
#define IAPP_H

#include <class.pph>
#include <argparse.pph>
#include <dstr.h>
#include <parr.h>

CLASS(IApp)
{
    FIELD(ArgParser *, args)
    FIELD(bool, show_help)
    FIELD(dstr_t, program)

    METHOD(void, configure_args, (void *self))
    METHOD(int, run, (void *self))

    METHOD(void, parse_args, (void *self, const parr_t *argv))
    METHOD(void, print_help, (void *self))
    METHOD(int, main, (void *self))
};

CLASS_EXPORT(IApp);

void METHOD_DECL(IApp, configure_args)(void *self);
int METHOD_DECL(IApp, run)(void *self);
void METHOD_DECL(IApp, parse_args)(void *self, const parr_t *argv);
void METHOD_DECL(IApp, print_help)(void *self);
int METHOD_DECL(IApp, main)(void *self);

#endif /* IAPP_H */
