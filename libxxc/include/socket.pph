#ifndef SOCKET_H
#define SOCKET_H

#include <def.h>
#include <class.pph>
#include <stream.pph>
#include <sock.h>

CLASS(SocketStream, Stream)
{
    BASE(Stream)
    FIELD(sock_t, fd)
    FIELD(bool,   owns_fd)
    FIELD(bool,   eof_flag)
};

CLASS_EXPORT(SocketStream);

METHOD_PROTO(SocketStream, i64,  read,  (void *self, void *buf, size_t n));
METHOD_PROTO(SocketStream, i64,  write, (void *self, const void *buf, size_t n));
METHOD_PROTO(SocketStream, i64,  seek,  (void *self, i64 offset, int whence));
METHOD_PROTO(SocketStream, i64,  tell,  (void *self));
METHOD_PROTO(SocketStream, int,  eof,   (void *self));
METHOD_PROTO(SocketStream, void, close, (void *self));

Stream *tcp_connect(const char *host, u16 port);

SocketStream *tcp_listen(u32 bind_addr, u16 port, i32 backlog);

Stream *tcp_accept(SocketStream *listener, sock_addr_in_t *out_peer);

#endif /* SOCKET_H */
