#ifndef MEMS_H
#define MEMS_H

#include <def.h>
#include <class.pph>
#include <stream.pph>

CLASS(MemoryStream, Stream)
{
    BASE(Stream)
    FIELD(char *, buffer)
    FIELD(size_t, size)
    FIELD(size_t, capacity)
    FIELD(size_t, position)
};

CLASS_EXPORT(MemoryStream);

METHOD_PROTO(MemoryStream, i64, read, (void *self, void *buf, size_t n));
METHOD_PROTO(MemoryStream, i64, write, (void *self, const void *buf, size_t n));
METHOD_PROTO(MemoryStream, i64, seek, (void *self, i64 offset, int whence));
METHOD_PROTO(MemoryStream, i64, tell, (void *self));
METHOD_PROTO(MemoryStream, int, eof, (void *self));
METHOD_PROTO(MemoryStream, void, close, (void *self));

const char *mstream_get_buffer(MemoryStream *mstream);

#endif /* MIO_H */