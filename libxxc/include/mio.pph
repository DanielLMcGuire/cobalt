#ifndef MIO_H
#define MIO_H

#include <def.h>
#include <class.pph>
#include <stream.pph>

CLASS(MemoryStream)
{
    BASE(IStream)
    FIELD(char *, buffer)
    FIELD(size_t, size)
    FIELD(size_t, capacity)
    FIELD(size_t, position)
};

CLASS_EXPORT(MemoryStream);

const char *mstream_get_buffer(MemoryStream *mstream);

#endif /* MIO_H */