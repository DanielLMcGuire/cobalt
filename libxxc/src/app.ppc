#include <app.pph>
#include <fs_path.pph>
#include <sio.h>

CLASS_INFO_ROOT(Application);

CONSTRUCTOR(Application)
{
    self->show_help = false;
    self->program = (dstr_t){0};
    self->args = NEW(ArgParser);

    METHOD_LINK(Application, configure_args);
    METHOD_LINK(Application, run);
    METHOD_LINK(Application, parse_args);
    METHOD_LINK(Application, print_help);
    METHOD_LINK(Application, main);
}

DECONSTRUCTOR(Application)
{
    REMOVE(self->args);
    dstr_free(&self->program);
}

IMPLEMENT(Application, void, configure_args, (void *self))
{
    (void)self;
}

IMPLEMENT(Application, int, run, (void *self))
{
    (void)self;
    return 0;
}

IMPLEMENT(Application, void, parse_args, (void *self, const parr_t *argv))
{
    Application *this = (Application *)self;

    const char *path = NULL;

    if (argv && argv->len > 0) {
        path = (const char *)argv->data[0];
        dstr_t dsPath = dstr_new(path);
        FSPath *fPath = fs_path(dsPath);
        dstr_free(&dsPath);
        FSPath *fParent = CALL0(fPath, base);
        REMOVE(fPath);
        this->program = dstr_new(CALL0(fParent, data).data);
        REMOVE(fParent);
    } else {
        this->program = dstr_new("app");
    }

    CALL2(this->args, add_flag, "help", "Show this help message and exit");

    this->configure_args(self);

    CALL1(this->args, parse, argv);

    this->show_help = CALL1(this->args, get_bool, "help");
}

IMPLEMENT(Application, void, print_help, (void *self))
{
    Application *this = (Application *)self;

    printf("Usage: %s [OPTIONS...]\n", this->program.data ? this->program.data : "app");
    puts("OPTIONS:", SIOOUT);
    CALL0(this->args, print_flags);
}

IMPLEMENT(Application, int, main, (void *self))
{
    Application *this = (Application *)self;

    if (this->show_help)
    {
        this->print_help(self);
        return 0;
    }

    return this->run(self);
}
