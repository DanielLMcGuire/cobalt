#include <stream.pph>

IMPLEMENT(IStream, i64, read, (void *self, void *buf, size_t n))
{
    (void)self;
    (void)buf;
    (void)n;

    return -1;
}

IMPLEMENT(IStream, i64, write, (void *self, const void *buf, size_t n))
{
    (void)self;
    (void)buf;
    (void)n;

    return -1;
}

IMPLEMENT(IStream, i64, seek, (void *self, i64 offset, int whence))
{
    (void)self;
    (void)offset;
    (void)whence;

    return -1;
}

IMPLEMENT(IStream, i64, tell, (void *self))
{
    (void)self;

    return -1;
}

IMPLEMENT(IStream, int, eof, (void *self))
{
    (void)self;

    return 1;
}

IMPLEMENT(IStream, void, close, (void *self))
{
    (void)self;
}


CONSTRUCTOR(IStream)
{
    METHOD_LINK(IStream, read);
    METHOD_LINK(IStream, write);
    METHOD_LINK(IStream, seek);
    METHOD_LINK(IStream, tell);
    METHOD_LINK(IStream, eof);
    METHOD_LINK(IStream, close);
}

DECONSTRUCTOR(IStream)
{
    (void)self;
}

CLASS_INFO_ROOT(IStream);